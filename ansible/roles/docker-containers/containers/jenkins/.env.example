# Copy this file to .env and adjust values for your environment

# Jenkins controller IP on the Docker network (must be within the proxy subnet)
JENKINS_IP_ADDRESS=172.20.0.8

# External port for building the Jenkins URL (only used for the URL; routing is via Traefik)
JENKINS_PORT=8080

# Admin credentials for Jenkins CasC bootstrap
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin123

# Jenkins agent user (the user on the host machine that will run the agent)
JENKINS_AGENT_USER=jemmal

# Remote FS directory used by the built-in node in CasC
JENKINS_REMOTE_ROOT_DIR=/home/${JENKINS_AGENT_USER}/jenkins
