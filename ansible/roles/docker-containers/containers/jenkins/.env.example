# The playbook creates .env from these defaults when it is missing.
# Copy this file to .env only if you want to customize the generated values first.

# Public URL used by Jenkins in the UI and generated links.
# Keep this aligned with your Traefik route for browser access.
JENKINS_URL=http://jenkins.localhost

# Host port exposed for direct agent access without going through Traefik.
JENKINS_AGENT_PORT=18080

# Dedicated URL for agent connections from Unix, WSL, or other external clients.
JENKINS_AGENT_URL=http://localhost:18080

# Jenkins controller IP on the Docker network.
# This is only for container-to-container networking on the proxy subnet.
# Do not use this IP from Windows or WSL agents.
JENKINS_IP_ADDRESS=172.20.0.50

# Host port exposed by Docker for direct access from WSL or remote agents.
# Example from WSL: http://<host-ip>:8080/
JENKINS_PORT=8080

# Admin credentials for Jenkins CasC bootstrap.
# Replace the password before first start.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-before-first-run

# Jenkins agent user (the Linux user on the host machine that will run the agent)
JENKINS_AGENT_USER=your-linux-user

# Remote FS directory used by the built-in node in CasC
JENKINS_REMOTE_ROOT_DIR=/home/${JENKINS_AGENT_USER}/jenkins
